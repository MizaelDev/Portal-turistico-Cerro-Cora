{
  "name": "portal-cerro-cora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:game",
    "test:unit": "tsx --test tests/unit/*.test.ts tests/security/*.test.ts",
    "test:game": "tsx --test tests/game/*.test.ts",
    "test:browser": "playwright test",
    "k6:smoke": "k6 run tests/k6/load-test.js",
    "k6:load": "k6 run -e PROFILE=load tests/k6/load-test.js",
    "k6:stress": "k6 run -e PROFILE=stress tests/k6/load-test.js",
    "k6:cloud": "k6 cloud -e PROFILE=load tests/k6/load-test.js",
    "test:mobile": "tsx tests/game/mobile-qa.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "15.5.28",
    "next-themes": "^0.4.4",
    "radix-ui": "^1.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.54.2",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.5.28",
    "playwright-core": "^1.62.1",
    "postcss": "8.5.31",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
